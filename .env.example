# ================================================================
# SUPPLIMED — BACKEND API & MONGODB ATLAS ENVIRONMENT CONFIGURATION
# ================================================================

# Server Port and Mode
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://mdusmanakukara_db_user:UJRIgKrG6ZQkIeMZ@supplimed.okgbfsi.mongodb.net/?appName=supplimed
MONGODB_DB=supplimed

# Authentication (JWT & Session)
# Generate a secure 64-char key in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=supplimed_production_secure_secret_key_change_me_2026
JWT_EXPIRES_IN=7d

# Frontend & Application URLs
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://supplimed-website.vercel.app

# Persistent Media Storage (Cloudinary)
# If left blank, server defaults to local persistent uploads in /public/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=supplimed

# Email Notifications (Optional for Inquiry alerts)
EMAIL_PROVIDER=smtp
EMAIL_FROM=sales@supplimed.in
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
